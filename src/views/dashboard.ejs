<section class="space-y-6">
  <header class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-2">
    <div>
      <h1 class="text-2xl font-bold text-cyan-400">Bonjour <%= customer.name %> 👋</h1>
      <p class="text-slate-400 text-sm">Voici l'état de votre service StreamFacile.</p>
    </div>
    <span class="badge bg-emerald-500/20 text-emerald-400 border border-emerald-700">Service opérationnel</span>
  </header>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="card p-4">
      <p class="text-sm text-slate-400">Chaînes sélectionnées</p>
      <p class="text-3xl font-bold text-cyan-400 mt-1"><%= selected %> <span class="text-base text-slate-500">/ <%= maxChannels %></span></p>
      <p class="text-xs text-slate-500 mt-1"><%= remaining %> disponibles</p>
    </div>
    <div class="card p-4">
      <p class="text-sm text-slate-400">Appareils actifs</p>
      <p class="text-3xl font-bold text-emerald-400 mt-1"><%= deviceCount %></p>
      <p class="text-xs text-slate-500 mt-1">appareils enregistrés</p>
    </div>
    <div class="card p-4">
      <p class="text-sm text-slate-400">Billets d'aide ouverts</p>
      <p class="text-3xl font-bold text-cyan-400 mt-1"><%= openTickets %></p>
      <p class="text-xs text-slate-500 mt-1">en suivi</p>
    </div>
    <div class="card p-4">
      <p class="text-sm text-slate-400">Chaînes au catalogue</p>
      <p class="text-3xl font-bold text-emerald-400 mt-1"><%= catalogTotal %></p>
      <p class="text-xs text-slate-500 mt-1">à découvrir</p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="card p-5 lg:col-span-2">
      <h2 class="text-lg font-semibold text-slate-100 mb-3">Actions rapides</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <a href="/chaines" class="btn-primary">📺 Gérer mes chaînes</a>
        <a href="/approvisionnement" class="btn-ghost">⚙️ Synchroniser Dispatcharr</a>
        <a href="/support" class="btn-ghost">🛟 Signaler un problème</a>
        <a href="/compte" class="btn-ghost">👤 Mon profil</a>
      </div>

      <div class="mt-5">
        <div class="h-2 w-full bg-slate-700 rounded-full overflow-hidden">
          <div class="h-full bg-cyan-500" style="width: <%= Math.min(100, Math.round((selected / Math.max(1, maxChannels)) * 100)) %>%"></div>
        </div>
        <p class="text-xs text-slate-500 mt-2">
          Utilisation de votre forfait <%= customer.plan_name %>.
        </p>
      </div>
    </div>

    <div class="card p-5">
      <h2 class="text-lg font-semibold text-slate-100 mb-3">Vos appareils</h2>
      <% if (!devices.length) { %>
        <p class="text-sm text-slate-500">Aucun appareil enregistré pour l'instant.</p>
      <% } else { %>
        <ul class="space-y-3">
          <% devices.forEach(function(d){ %>
            <li class="flex items-start justify-between gap-2 border-b border-slate-700 pb-2 last:border-0">
              <div>
                <p class="text-sm font-medium text-slate-200"><%= d.device_name %></p>
                <p class="text-xs text-slate-500"><%= d.device_type %> · <%= d.platform %></p>
              </div>
              <span class="badge bg-slate-700 text-slate-300"><%= d.last_active_at ? 'Actif' : 'Inactif' %></span>
            </li>
          <% }); %>
        </ul>
      <% } %>
    </div>
  </div>

  <% if (lastJob) { %>
    <div class="card p-4 text-sm">
      <span class="text-slate-400">Dernière synchronisation :</span>
      <span class="text-slate-200 font-medium"><%= lastJob.status %></span>
      <span class="text-slate-500">— <%= new Date(lastJob.created_at).toLocaleString('fr-CA') %></span>
    </div>
  <% } %>
</section>

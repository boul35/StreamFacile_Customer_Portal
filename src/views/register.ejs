<div class="max-w-md mx-auto mt-10 card p-6">
  <h1 class="text-2xl font-bold text-cyan-400 mb-1">Créer un compte</h1>
  <p class="text-slate-400 text-sm mb-6">Rejoignez StreamFacile en quelques secondes.</p>

  <% if (errors && errors.length) { %>
    <ul class="mb-4 rounded-lg bg-rose-900/40 border border-rose-700 text-rose-200 text-sm px-3 py-2">
      <% errors.forEach(function(e){ %><li><%= e.msg %></li><% }); %>
    </ul>
  <% } %>

  <form method="POST" action="/inscription" class="space-y-4">
    <%- include('partials/csrf') %>
    <div>
      <label class="label" for="name">Nom complet</label>
      <input class="input" type="text" id="name" name="name" value="<%= values.name || '' %>" required />
    </div>
    <div>
      <label class="label" for="email">Courriel</label>
      <input class="input" type="email" id="email" name="email" value="<%= values.email || '' %>" required />
    </div>
    <div>
      <label class="label" for="phone">Téléphone</label>
      <input class="input" type="tel" id="phone" name="phone" value="<%= values.phone || '' %>" placeholder="ex. 418 555-0101" />
    </div>
    <div>
      <label class="label" for="plan">Forfait</label>
      <select class="input" id="plan" name="plan">
        <% (plans || []).forEach(function(p){ %>
          <option value="<%= p.slug %>"><%= p.name %> — <%= p.max_channels %> chaînes — <%= p.price_cad %> $/mois</option>
        <% }); %>
      </select>
    </div>
    <div>
      <label class="label" for="password">Mot de passe</label>
      <input class="input" type="password" id="password" name="password" required />
      <p class="text-xs text-slate-500 mt-1">Au moins 8 caractères.</p>
    </div>
    <button type="submit" class="btn-primary w-full">Créer mon compte</button>
  </form>

  <p class="text-sm text-slate-400 mt-6 text-center">
    Déjà client?
    <a href="/connexion" class="text-cyan-400 hover:underline">Se connecter</a>
  </p>
</div>

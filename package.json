{
  "name": "streamfacile-customer-portal",
  "version": "1.0.0",
  "description": "Portail client StreamFacile — service de diffusion IPTV clé en main pour les clients du Québec",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "build:css": "tailwindcss -i ./public/css/input.css -o ./public/css/main.css --minify",
    "watch:css": "tailwindcss -i ./public/css/input.css -o ./public/css/main.css --watch",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "test": "jest"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^9.0.1",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express-ejs-layouts": "^1.0.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-session": "^1.18.0",
    "express-validator": "^7.1.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "postcss": "^8.4.39",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.6"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ],
    "globalSetup": "<rootDir>/tests/globalSetup.js",
    "testTimeout": 20000
  }
}

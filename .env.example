# ============================================================
# StreamFacile — Variables d'environnement
# Copiez ce fichier en .env et ajustez les valeurs.
# ============================================================

# Base de données PostgreSQL
DATABASE_URL=postgres://streamfacile:streamfacile@localhost:5432/streamfacile

# Session (générez une chaîne aléatoire longue en production)
SESSION_SECRET=changez-cette-cle-de-session-en-production

# Port d'écoute de l'application
PORT=3000

# ============================================================
# Dispatcharr — les identifiants CI-DESSOUS NE QUITTENT JAMAIS
# le serveur. Ils ne sont jamais envoyés au navigateur.
# ============================================================
DISPATCHARR_BASE_URL=https://dispatcharr.exemple.qc.ca
DISPATCHARR_API_KEY=
DISPATCHARR_ACCOUNT_ID=

# Mode simulation : si "true", aucune requête réseau réelle n'est
# envoyée à Dispatcharr (utile en développement/local).
DISPATCHARR_SIMULATION=true

# Délai (ms) avant de considérer un travail d'approvisionnement
# comme expiré.
PROVISIONING_TIMEOUT_MS=120000
